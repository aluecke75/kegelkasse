# ============================================================
# Kegelkasse
# Beispiel-Konfiguration (.env.example)
# ============================================================

# ------------------------------------------------------------
# Flask
# ------------------------------------------------------------
SECRET_KEY=change-me

# ------------------------------------------------------------
# Standard-Administrator
# ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ------------------------------------------------------------
# Synology / Linux
# ------------------------------------------------------------
PUID=1027
PGID=100
TZ=Europe/Berlin

# ------------------------------------------------------------
# Anwendung
# ------------------------------------------------------------
APP_PORT=8091
DEVELOPER_MODE=false

# ------------------------------------------------------------
# Build: DeveloperKit (privates GitHub-Repo)
# Nur für "docker compose build" nötig, nicht zur Laufzeit.
# GitHub Personal Access Token mit Lesezugriff auf
# aluecke75/DeveloperKit (klassisch: Scope "repo"; fine-grained:
# "Contents: Read-only" nur für dieses Repo). Wird von compose.yml
# automatisch als Build-Secret "gh_token" eingelesen.
# ------------------------------------------------------------
GITHUB_TOKEN=

# ------------------------------------------------------------
# Docker-Pfade (optional)
# Leer = compose.yml verwendet automatisch die Standardpfade.
# Synology: Werte in der lokalen .env eintragen.
# ------------------------------------------------------------
KEGELKASSE_DATABASE_PATH=
KEGELKASSE_BACKUP_PATH=
KEGELKASSE_UPLOADS_PATH=
KEGELKASSE_LOGS_PATH=