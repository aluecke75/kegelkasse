# ============================================================
# Kegelkasse
# Beispiel-Konfiguration (.env.example)
# ============================================================

# ------------------------------------------------------------
# Flask
# ------------------------------------------------------------
SECRET_KEY=change-me

# ------------------------------------------------------------
# Standard-Administrator
# ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ------------------------------------------------------------
# Synology / Linux
# ------------------------------------------------------------
PUID=1027
PGID=100
TZ=Europe/Berlin

# ------------------------------------------------------------
# Anwendung
# ------------------------------------------------------------
APP_PORT=8091

# Nur auf true setzen, wenn WIRKLICH jeder Zugriff (auch im lokalen Netz)
# ausschließlich über HTTPS läuft (z.B. Reverse-Proxy) - sonst kann sich
# niemand mehr per direktem http://<nas-ip>:APP_PORT einloggen, da der
# Browser das Session-Cookie dann nur noch über HTTPS sendet.
SESSION_COOKIE_SECURE=false

# ------------------------------------------------------------
# Nur nötig, wenn du selbst aus dem Quellcode baust
# ("docker compose up -d --build") statt das vorgefertigte Image
# von ghcr.io zu verwenden (Standardweg, siehe README). Build:
# DeveloperKit (privates GitHub-Repo). GitHub Personal Access
# Token mit Lesezugriff auf aluecke75/DeveloperKit (klassisch:
# Scope "repo"; fine-grained: "Contents: Read-only" nur für
# dieses Repo). Wird von compose.yml automatisch als Build-Secret
# "gh_token" eingelesen.
# ------------------------------------------------------------
GITHUB_TOKEN=

# ------------------------------------------------------------
# Image-Version (optional)
# Leer/"latest" = immer neuestes veröffentlichtes Image. Für
# kontrolliertes Aktualisieren auf eine feste Version setzen,
# z. B. v0.99.19.
# ------------------------------------------------------------
KEGELKASSE_VERSION=

# ------------------------------------------------------------
# Docker-Pfade (optional)
# Leer = compose.yml verwendet automatisch die Standardpfade.
# Synology: Werte in der lokalen .env eintragen.
# ------------------------------------------------------------
KEGELKASSE_DATABASE_PATH=
KEGELKASSE_BACKUP_PATH=
KEGELKASSE_UPLOADS_PATH=
KEGELKASSE_LOGS_PATH=

# ------------------------------------------------------------
# Zweiter Container "kegelkasse-demo" (eigener Port, eigenes Volume,
# nutzt dasselbe Image wie oben). Für Tests/Vorführung mit einer
# Demo-Datenbank, komplett getrennt von der echten Vereinsdatenbank.
# ------------------------------------------------------------
KEGELKASSE_DEMO_PORT=8092
KEGELKASSE_DEMO_DATABASE_PATH=
KEGELKASSE_DEMO_BACKUP_PATH=
KEGELKASSE_DEMO_UPLOADS_PATH=
KEGELKASSE_DEMO_LOGS_PATH=